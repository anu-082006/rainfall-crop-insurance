# Contract deployment (Member 1). Use throwaway development keys only.
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xyour_development_private_key

# Address allowed to call RainfallReportReceiver.onReport:
#  - CRE simulation: MockKeystoneForwarder for the chosen network
#  - CRE deployment: KeystoneForwarder for the chosen network
#  - Local fallback: a labelled local reporter account
FORWARDER_ADDRESS=0xforwarder_or_local_reporter_address
