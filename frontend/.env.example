# ============================================================
# Frontend Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to the repository.
# ============================================================

# ── Network ──────────────────────────────────────────────────
# Chain ID for the local Anvil test network (31337)
# Change to the deployed network's chain ID when using a testnet.
NEXT_PUBLIC_CHAIN_ID=31337

# RPC endpoint for read-only calls (not for signing – MetaMask handles that)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Human-readable name shown in the network banner
NEXT_PUBLIC_CHAIN_NAME=Anvil Local

# ── Smart contract ───────────────────────────────────────────
# Set by Member 1 after deployment.
# Leave blank to use mock mode.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Block explorer base URL (leave blank if none exists for local Anvil)
NEXT_PUBLIC_EXPLORER_URL=

# ── Mock mode ────────────────────────────────────────────────
# true  = use mock catalogue, mock policies and mock ABI (no real contract needed)
# false = read from the real deployed contract (requires CONTRACT_ADDRESS above)
NEXT_PUBLIC_MOCK_MODE=true

# ── AI service ───────────────────────────────────────────────
NEXT_PUBLIC_AI_API_URL=http://localhost:8000

# ── Admin address (optional, for the admin page) ─────────────
# The MetaMask address allowed to see the /admin page.
NEXT_PUBLIC_ADMIN_ADDRESS=
