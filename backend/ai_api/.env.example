# ==============================================================================
# AgriShield AI Recommendation Service Environment Configuration (.env.example)
# ==============================================================================

# Port to serve the FastAPI application
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1

# Weather client mode
# Set MOCK_WEATHER=true to use deterministic regional climatological data (ideal for offline sandboxes)
# Set MOCK_WEATHER=false to query live Open-Meteo Historical Archive API
MOCK_WEATHER=true

# Optional path to Member 2 trained scikit-learn model artifact (.joblib or .pkl)
# Leave empty to use built-in MockModelAdapter baseline
MODEL_PATH=

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
